{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["assets/js/app.js", "assets/js/tools/**/*.js"],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}
